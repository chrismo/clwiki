<% content_for :title, "ClWiki: Recent" %>

<% @pages.each do |page| %>
  <div class='wikiHeader'>
    <span class='pageName'><%= @formatter.convert_to_link(page.name).html_safe %></span><br/>
    <span class='wikiPageData'><%= @formatter.page_update_time(page).html_safe %></span>
  </div>
  <%= page.content.html_safe %>
<% end %>
